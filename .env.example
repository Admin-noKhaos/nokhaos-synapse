# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Meta (Facebook / Instagram) ---
# Instagram Login flow uses the INSTAGRAM app id/secret:
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business (Page connect) uses the PARENT Meta app id/secret
# (different from the Instagram ones above):
META_FB_APP_ID=
META_FB_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# Public URL for OAuth redirect & webhook (https only). Vercel sets this automatically once deployed.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Credits ---
# USD per Anthropic dollar charged to the user (markup multiplier).
CREDIT_MARKUP=2.0
# Free credits granted on signup (USD).
SIGNUP_FREE_CREDITS_USD=5

# --- Worker (Render) ---
# Shared secret between web -> worker for internal calls
WORKER_INTERNAL_TOKEN=
WORKER_URL=
